# Browser-safe values. Copy to .env.local and fill with your own project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional: Photon search endpoint. No account or API key is needed.
# Omit to use this default; replace with another compatible HTTPS instance.
NEXT_PUBLIC_PHOTON_URL=https://photon.komoot.io/api/
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OWNER-ONLY: place the next values in a separate .env.owner file, NEVER deploy
# them to the frontend, add NEXT_PUBLIC_ to their names, or commit the file.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SB_SECRET_KEY
# Legacy projects can instead use SUPABASE_SERVICE_ROLE_KEY (never public).
# APP_URL=http://localhost:3000
