# Browser-safe values. Copy to .env.local and fill with your own project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional: Photon search endpoint. No account or API key is needed.
# Omit to use this default; replace with another compatible HTTPS instance.
NEXT_PUBLIC_PHOTON_URL=https://photon.komoot.io/api/
# Optional reference URL. The invitation button uses the browser's current domain.
# On Render, use the deployed HTTPS URL when other tools need this value.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# No invitation setup or administrative key is needed by the app.
